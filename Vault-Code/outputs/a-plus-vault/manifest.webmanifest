{
  "id": "/vault",
  "name": "A+ Vault",
  "short_name": "Vault",
  "description": "Keep creative references from anywhere. Organize them into moodboards and projects.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/vault?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#101113",
  "theme_color": "#101113",
  "categories": ["design", "productivity", "photo"],
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Museum", "short_name": "Museum", "url": "/discover?source=shortcut", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "My Vault", "short_name": "Vault", "url": "/vault?source=shortcut", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Moodboards", "short_name": "Boards", "url": "/moodboards?source=shortcut", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/jpeg", "image/png", "image/webp"] }]
    }
  }
}
