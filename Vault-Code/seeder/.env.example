# Server-only. Never expose these in the Vault static app or the extension.
NEXT_PUBLIC_SUPABASE_URL=https://zkflkpbmbozrchqncpzi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
SEEDER_VISION_MODEL=claude-haiku-4-5

# Inngest Cloud. For local dev set INNGEST_DEV=1 instead.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Contact sent to museum APIs in the User-Agent (AIC asks for this).
SEEDER_CONTACT=passawut.a.plus@gmail.com

# Cost caps per scheduler run.
SEEDER_BATCH_SIZE=20
SEEDER_MAX_BATCHES_PER_RUN=10

# Smithsonian Open Access (free key from https://api.data.gov/signup/). Falls back to DEMO_KEY (very low limit).
SMITHSONIAN_API_KEY=
