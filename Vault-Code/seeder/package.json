{
  "name": "a-plus-vault-seeder",
  "version": "0.1.0",
  "private": true,
  "description": "Discover seeder for A+ Vault: pulls CC0 museum images, runs the moderation/tagging pipeline, and serves /admin/seeder.",
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "seeder:dry": "tsx scripts/dry-run.ts",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3010/api/inngest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "blurhash": "^2.0.5",
    "inngest": "^4.21.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
