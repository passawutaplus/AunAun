{
  "manifest_version": 3,
  "name": "A+ Vault Capture",
  "version": "0.4.6",
  "description": "Keep creative references in your private A+ Vault library.",
  "homepage_url": "https://aplus-vault-demo.vercel.app/demo",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:5177/*",
    "http://localhost:5177/*",
    "https://aplus-vault.vercel.app/*",
    "https://aplus-vault-demo.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:5177/*",
        "http://localhost:5177/*",
        "https://aplus-vault.vercel.app/*",
        "https://aplus-vault-demo.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Agrandir-Wide-Light.woff2",
        "lib/keep-all.js",
        "lib/credit.js",
        "lib/keep.js",
        "popup.html",
        "popup.js",
        "popup.css",
        "icons/*",
        "art/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "commands": {
    "quick-keep-page": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Quick keep this page in your Vault"
    }
  },
  "action": {
    "default_title": "Keep in Vault",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
